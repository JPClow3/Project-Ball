{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-ball-web",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "PROJECT_BALL_DB",
      "database_name": "project-ball-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  // Local dev/reference values. For Git-connected Cloudflare Pages builds,
  // mirror the PUBLIC_* keys in Workers & Pages > Settings > Variables and Secrets.
  "vars": {
    "PUBLIC_APP_NAME": "Project Ball",
    "PUBLIC_APP_URL": "http://localhost:4321",
    "PUBLIC_CHAIN_ID": "11142220",
    "PUBLIC_CELO_RPC_URL": "https://forno.celo-sepolia.celo-testnet.org",
    "PUBLIC_CELO_EXPLORER_URL": "https://celo-sepolia.blockscout.com",
    "PUBLIC_PROJECT_BALL_POOLS_ADDRESS": "0x0000000000000000000000000000000000000000",
    "PUBLIC_SUPPORT_URL": "https://t.me/projectball_support"
  }
}
