---
const links = [
  { href: "/about", label: "Sobre" },
  { href: "/terms", label: "Termos" },
  { href: "/privacy", label: "Privacidade" },
  { href: "/support", label: "Suporte" },
  { href: "/stats", label: "Números" }
] as const;
---

<footer class="site-footer">
  <div class="app-shell site-footer-inner">
    <div>
      <p class="footer-brand">Project Ball</p>
      <p class="mt-2 text-sm font-semibold text-[var(--muted)]">Palpites da Copa com dólar digital na rede Celo.</p>
    </div>
    <nav class="footer-nav" aria-label="Rodapé">
      {links.map((link) => <a class="focus-ring" href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>
