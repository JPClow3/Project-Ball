---
import { formatKickoff, formatUsd } from "../lib/format";
import type { MatchViewModel } from "../data/matches";
import { defaultStakeUsd, getOutcomePoolShares } from "../data/betting";
import { getDefaultStablecoin } from "../lib/tokens";
import OutcomePicker from "./OutcomePicker.astro";
import StakeStepper from "./StakeStepper.astro";
import { BadgeDollarSign, CircleCheck, CircleDot, Clock3, Coins, LockKeyhole, MapPin } from "lucide-astro";

type Props = {
  match: MatchViewModel;
  featured?: boolean;
  compact?: boolean;
};

const { match, featured = false, compact = false } = Astro.props;

const poolShareLabels = {
  HOME: match.homeTeam,
  DRAW: "Empate",
  AWAY: match.awayTeam
} as const;
const poolShares = getOutcomePoolShares(match.outcomeTotalsUsd).map((item) => ({
  ...item,
  label: poolShareLabels[item.outcome]
}));
const totalShare = poolShares.reduce((total, item) => total + item.share, 0);
const displayedPoolShares = poolShares.map((item, index) => ({
  ...item,
  barShare: totalShare > 0 ? item.share : index === poolShares.length - 1 ? 34 : 33
}));
const isConfirmed = Boolean(match.userPick);
const isLocked = match.status !== "open";
const controlsDisabled = isLocked || isConfirmed;
const statusLabel = isConfirmed
  ? "Confirmado"
  : match.status === "open"
    ? "Aberto"
    : match.status === "locked"
      ? "Travado"
      : match.status;
const StatusIcon = isConfirmed ? CircleCheck : match.status === "open" ? CircleDot : LockKeyhole;
const statusClass = match.status === "open" && !isConfirmed ? "status-pill--open" : "status-pill--locked";
const homeFlagUrl = `https://flagcdn.com/w80/${match.homeFlagCode}.png`;
const awayFlagUrl = `https://flagcdn.com/w80/${match.awayFlagCode}.png`;
const cardTitle = `${match.homeTeam} x ${match.awayTeam}`;
const defaultToken = getDefaultStablecoin();
---

<article
  id={`match-card-${match.id}`}
  data-match-card
  data-filter-card
  data-match-id={match.id}
  data-match-onchain-id={match.onchainId}
  data-match-kickoff-iso={match.kickoffIso}
  data-home-team={match.homeTeam}
  data-away-team={match.awayTeam}
  data-home-flag-code={match.homeFlagCode}
  data-away-flag-code={match.awayFlagCode}
  data-confirmed={isConfirmed ? "true" : undefined}
  class:list={["match-card", featured && "match-card-featured", compact && "match-card-compact"]}
  transition:name={`match-card-${match.id}`}
>
  <div class="match-card-body">
    <div class="match-topline">
      <div class="min-w-0">
        <p class="match-label">{match.groupLabel}</p>
        <h2 class="sr-only">{cardTitle}</h2>
        <p class="mt-1 truncate text-xs font-semibold uppercase text-[var(--muted)]">{defaultToken.label} padrão - {match.competition}</p>
      </div>
      <span class:list={["status-pill", statusClass]}>
        <StatusIcon size={14} aria-hidden="true" />
        {statusLabel}
      </span>
    </div>

    <div class="teams-line" aria-label={cardTitle}>
      <div class="team-block">
        <img class="flag-img" src={homeFlagUrl} alt={`Bandeira: ${match.homeCountry}`} loading="lazy" />
        <p class="team-name">{match.homeTeam}</p>
      </div>
      <span class="versus-pill" aria-hidden="true">x</span>
      <div class="team-block team-block--away">
        <img class="flag-img ml-auto" src={awayFlagUrl} alt={`Bandeira: ${match.awayCountry}`} loading="lazy" />
        <p class="team-name">{match.awayTeam}</p>
      </div>
    </div>

    <p class="match-meta-row">
      <span>
        <Clock3 size={16} class="text-[var(--cyan)]" aria-hidden="true" />
        {formatKickoff(match.kickoffIso)}
      </span>
      <span class="min-w-0">
        <MapPin size={16} class="text-[var(--gold)]" aria-hidden="true" />
        <span class="truncate">{match.venue}</span>
      </span>
    </p>

    <div class="match-finance-row" aria-label="Resumo do pote">
      <div class="finance-stat">
        <p class="finance-label">
          <Coins size={14} class="text-[var(--gold)]" aria-hidden="true" />
          Pote agora
        </p>
        <p class="finance-value text-[var(--green)]">{formatUsd(match.poolUsd)}</p>
      </div>
      <div class="finance-stat">
        <p class="finance-label justify-end">
          <BadgeDollarSign size={14} class="text-[var(--cyan)]" aria-hidden="true" />
          Valor padrão
        </p>
        <p class="finance-value">{formatUsd(defaultStakeUsd)}</p>
      </div>
    </div>

    <div class="pool-stack">
      <div class="pool-label-row">
        <span>{match.supporterCount} palpites</span>
        <span>Divisão do pote</span>
      </div>
      <div class="pool-track" aria-hidden="true">
        {displayedPoolShares.map((item) => <span class:list={["pool-fill", item.color]} style={`width: ${item.barShare}%`}></span>)}
      </div>
      <div class="pool-legend">
        {
          poolShares.map((item) => (
            <p class="pool-legend-item">
              <strong>{item.share}%</strong> {item.label}
            </p>
          ))
        }
      </div>
    </div>

    <form
      class="grid gap-3"
      hx-post="/api/confirm-bet"
      hx-target={`#match-card-${match.id}`}
      hx-swap="outerHTML"
      data-bet-form
    >
      <input type="hidden" name="matchId" value={match.id} />

      <div class="grid gap-2">
        <div class="flex items-center justify-between gap-2">
          <p class="text-sm font-semibold text-[var(--text)]">Seu palpite</p>
          {isConfirmed && <p class="text-xs font-semibold uppercase text-[var(--green)]">Registrado</p>}
        </div>
        <OutcomePicker
          matchId={match.id}
          homeTeam={match.homeTeam}
          awayTeam={match.awayTeam}
          homeFlagCode={match.homeFlagCode}
          awayFlagCode={match.awayFlagCode}
          selected={match.userPick}
          disabled={controlsDisabled}
        />
      </div>

      {
        match.status === "open" && !isConfirmed ? (
          <>
            <div class="grid gap-2">
              <p class="text-sm font-semibold text-[var(--text)]">Valor</p>
              <StakeStepper id={`custom-stake-${match.id}`} />
            </div>
            <button
              class="btn-primary focus-ring w-full"
              type="button"
              disabled
              data-place-bet
              data-match-id={match.id}
              data-match-onchain-id={match.onchainId}
              data-outcome=""
            >
              <LockKeyhole size={16} aria-hidden="true" />
              Confirmar palpite
            </button>
          </>
        ) : (
          <div class="rounded-[8px] border border-[rgba(97,229,149,0.28)] bg-[rgba(97,229,149,0.09)] p-3">
            <p class="flex items-center gap-1.5 text-sm font-semibold text-[var(--text)]">
              <CircleCheck size={16} class="text-[var(--green)]" aria-hidden="true" />
              Palpite registrado
            </p>
            <p class="mt-1 text-sm font-semibold text-[var(--muted)]">A partida libera saque, reembolso ou liquidação quando o resultado for confirmado.</p>
          </div>
        )
      }
    </form>
  </div>
</article>
