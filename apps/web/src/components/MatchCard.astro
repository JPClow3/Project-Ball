---
import { formatUsd } from "../lib/format";
import type { MatchViewModel } from "../data/matches";
import { getOutcomePoolShares } from "../data/betting";
import { getDefaultStablecoin } from "../lib/tokens";
import OutcomePicker from "./OutcomePicker.astro";
import StakeStepper from "./StakeStepper.astro";
import { useTranslations } from "../i18n";

const t = useTranslations(Astro.locals.lang);

type Props = {
  match: MatchViewModel;
  featured?: boolean;
  compact?: boolean;
  loading?: "lazy" | "eager";
};

const { match, featured = false, compact = false, loading = "lazy" } = Astro.props;

const poolShareLabels = {
  HOME: match.homeTeam,
  DRAW: t("ticket.draw"),
  AWAY: match.awayTeam
} as const;
const poolShares = getOutcomePoolShares(match.outcomeTotalsUsd).map((item) => ({
  ...item,
  label: poolShareLabels[item.outcome]
}));
const totalShare = poolShares.reduce((total, item) => total + item.share, 0);
const displayedPoolShares = poolShares.map((item, index) => ({
  ...item,
  barShare: totalShare > 0 ? item.share : index === poolShares.length - 1 ? 34 : 33
}));
const isConfirmed = Boolean(match.userPick);
const isLocked = match.status !== "open";
const controlsDisabled = isLocked || isConfirmed;
const statusClass = match.status === "open" && !isConfirmed ? "status-pill--open" : "status-pill--locked";
const homeFlagUrl = match.homeFlagCode ? `https://flagcdn.com/w64/${match.homeFlagCode}.png` : "";
const awayFlagUrl = match.awayFlagCode ? `https://flagcdn.com/w64/${match.awayFlagCode}.png` : "";
const cardTitle = `${match.homeTeam} x ${match.awayTeam}`;
const defaultToken = getDefaultStablecoin();
const statusId = `bet-status-${match.id}`;
const selectedResultText =
  match.userPick === "DRAW"
    ? t("ticket.draw")
    : match.userPick === "HOME"
      ? `${match.homeTeam} ${t("match.wins")}`
      : match.userPick === "AWAY"
        ? `${match.awayTeam} ${t("match.wins")}`
        : "";

const kickoffDate = new Date(match.kickoffIso);
const kickoffWeekday = new Intl.DateTimeFormat("pt-BR", { weekday: "short" }).format(kickoffDate);
const kickoffTime = new Intl.DateTimeFormat("pt-BR", { hour: "2-digit", minute: "2-digit" }).format(kickoffDate);
---

<article
  id={`match-card-${match.id}`}
  data-match-card
  data-filter-card
  data-match-id={match.id}
  data-match-onchain-id={match.onchainId}
  data-match-kickoff-iso={match.kickoffIso}
  data-home-team={match.homeTeam}
  data-away-team={match.awayTeam}
  data-home-flag-code={match.homeFlagCode}
  data-away-flag-code={match.awayFlagCode}
  data-match-status={match.status}
  data-confirmed={isConfirmed ? "true" : undefined}
  aria-describedby={statusId}
  aria-labelledby={`match-title-${match.id}`}
  class:list={["match-card", featured && "match-card-featured", compact && "match-card-compact"]}
  transition:name={`match-card-${match.id}`}
>
  <div class="match-card-body">
    <div class="flex items-center justify-between mb-4">
      <div class="bg-[var(--surface-muted)] px-3 py-1 rounded-full text-xs font-bold text-[var(--muted-strong)] uppercase tracking-wider">
        {match.groupLabel}
      </div>
      <span class:list={["status-pill", statusClass]}>
        <i class="fa-solid fa-circle text-[var(--green)] ui-icon" style="font-size: 8px;" aria-hidden="true"></i>
        {match.status === "open" ? t("match.open") : t("match.locked")}
      </span>
    </div>
    <h2 id={`match-title-${match.id}`} class="sr-only">{cardTitle}</h2>

    <div class="teams-line" role="group" aria-label={cardTitle}>
      <div class="team-block">
        {homeFlagUrl && <img class="flag-img" src={homeFlagUrl} alt={`Bandeira: ${match.homeCountry}`} loading={loading} decoding="async" />}
        <p class="team-name">{match.homeTeam}</p>
      </div>
      
      <div class="flex flex-col items-center justify-center">
        <span class="text-xs font-semibold text-[var(--muted)]">{kickoffWeekday}</span>
        <span class="text-2xl lg:text-3xl font-black text-[var(--text)] leading-none my-1">{kickoffTime}</span>
        <span class="text-[10px] font-bold text-[var(--muted-strong)]">BRT</span>
      </div>

      <div class="team-block team-block--away">
        {awayFlagUrl && <img class="flag-img ml-auto" src={awayFlagUrl} alt={`Bandeira: ${match.awayCountry}`} loading={loading} decoding="async" />}
        <p class="team-name">{match.awayTeam}</p>
      </div>
    </div>



    <div class="pool-stack mt-4">
      <div class="flex items-end justify-between">
        <div class="flex flex-col">
          <span class="text-xs font-semibold text-[var(--muted-strong)]">{Number(match.poolUsd) > 0 ? "Pote agora" : `${match.supporterCount.toLocaleString("pt-BR")} palpites`}</span>
          {Number(match.poolUsd) > 0 && <span class="text-2xl font-bold text-[var(--green)]">{formatUsd(match.poolUsd)}</span>}
        </div>
        <div class="flex flex-col items-end">
          <span class="text-xs font-semibold text-[var(--muted-strong)]">{Number(match.poolUsd) > 0 ? "Valor padrão" : "Divisão do pote"}</span>
          {Number(match.poolUsd) > 0 && <span class="text-2xl font-bold text-[var(--text)]">{formatUsd(5)}</span>}
        </div>
      </div>
      
      {Number(match.poolUsd) > 0 && (
        <>
          <div class="pool-track mt-2" aria-hidden="true">
            {displayedPoolShares.map((item) => <span class:list={["pool-fill", item.color]} style={`width: ${item.barShare}%`}></span>)}
          </div>
          <div class="pool-legend">
            {poolShares.map((item) => {
              const cssColor = item.color.match(/\[(.*?)\]/)?.[1] || "var(--text)";
              const styleStr = cssColor.startsWith("--") ? `color: var(${cssColor})` : `color: ${cssColor}`;
              return (
                <p class="pool-legend-item">
                  <strong style={styleStr}>{item.share}%</strong> <span style={styleStr}>{item.label}</span>
                </p>
              );
            })}
          </div>
        </>
      )}
    </div>

    <form
      class="grid gap-6 mt-auto"
      data-bet-form
    >
      <input type="hidden" name="matchId" value={match.id} />

      <div class="grid gap-4">
        {isConfirmed ? (
          <div class="flex items-center justify-between gap-2">
            <p class="text-sm font-semibold text-[var(--text)]">Seu palpite</p>
            <p class="text-xs font-semibold uppercase text-[var(--green)]">Registrado</p>
          </div>
        ) : null}
        <OutcomePicker
          matchId={match.id}
          homeTeam={match.homeTeam}
          awayTeam={match.awayTeam}
          homeFlagCode={match.homeFlagCode}
          awayFlagCode={match.awayFlagCode}
          selected={match.userPick}
          disabled={controlsDisabled}
        />
      </div>

      <p id={statusId} class="bet-status" data-bet-status role="status" aria-live="polite" tabindex="-1" hidden></p>

      {
        match.status === "open" && !isConfirmed ? (
          <>
            <div class="grid gap-2" data-stake-container hidden>
              <div class="flex items-center justify-between">
                <label class="text-sm font-semibold text-[var(--text)]" for={`custom-stake-${match.id}`}>Valor</label>
                <span class="text-xs font-bold bg-[var(--surface-variant)] px-2 py-1 rounded-full text-[var(--text)]" data-preferred-token-badge>{defaultToken.symbol}</span>
              </div>
              <StakeStepper id={`custom-stake-${match.id}`} />
            </div>
            <button
              class="btn-primary focus-ring w-full opacity-60 cursor-not-allowed"
              type="button"
              disabled
              data-place-bet
              data-match-id={match.id}
              data-match-onchain-id={match.onchainId}
              data-outcome=""
              title={t("match.pickFirst")}
            >
              {t("match.pickFirst")}
            </button>
          </>
        ) : isConfirmed ? (
          <div class="success-panel" data-confirmed-panel tabindex="-1">
            <p class="flex items-center gap-2 text-sm font-bold text-[var(--text)]">
              <i class="fa-solid fa-circle-check text-[var(--green)] ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
              Palpite registrado
            </p>
            <p class="text-sm font-medium text-[var(--muted)]">
              {selectedResultText}. A partida libera saque, reembolso ou liquidação quando o resultado for confirmado.
            </p>
          </div>
        ) : match.status === "locked" ? (
          <div class="locked-panel">
            <p class="flex items-center gap-2 text-sm font-bold text-[var(--text)]">
              <i class="fa-solid fa-lock text-[var(--gold)] ui-icon fa-fade" style="font-size: 16px;" aria-hidden="true"></i>
              Aguardando resultado
            </p>
            <p class="text-sm font-medium text-[var(--muted)]">Esta partida não aceita novos palpites neste momento.</p>
          </div>
        ) : (
          <div class="locked-panel" style="border-left: 4px solid var(--green);">
            <p class="flex items-center gap-2 text-sm font-bold text-[var(--text)]">
              <i class="fa-solid fa-flag-checkered text-[var(--green)] ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
              Resultado confirmado
            </p>
            <p class="mt-2 text-sm font-medium text-[var(--text)]">
              Você ganhou aprox. $0.00 (em dólares digitais mistos).
            </p>
            <div class="flex items-center gap-2 mt-2 mb-4">
              <span class="text-xs bg-[var(--surface-variant)] px-2 py-1 rounded-full text-[var(--muted)]">USDm</span>
              <span class="text-xs bg-[var(--surface-variant)] px-2 py-1 rounded-full text-[var(--muted)]">USDC</span>
              <span class="text-xs bg-[var(--surface-variant)] px-2 py-1 rounded-full text-[var(--muted)]">USDT</span>
            </div>
            <button class="btn-primary focus-ring w-full" type="button" disabled>
              Resgatar prêmio
            </button>
          </div>
        )
      }
    </form>
  </div>
</article>
