---
import { accountSummaryItems } from "../data/account";
import { formatUsd } from "../lib/format";

const icons = {
  balance: "fa-solid fa-wallet",
  "active-stake": "fa-solid fa-arrow-trend-up",
  withdrawable: "fa-solid fa-trophy"
} as const;
---

<section class="app-shell pt-4" aria-label="Conta MiniPay" transition:name="balance-strip">
  <div class="surface-panel grid gap-4 p-4 sm:grid-cols-[1fr_auto] sm:items-center">
    <div class="grid grid-cols-3 gap-2">
      {
        accountSummaryItems.map((item) => {
          const IconClass = icons[item.id];
          return (
          <div class="rounded-[8px] border border-[var(--line)] bg-white/[0.035] p-4">
            <p class="flex min-w-0 items-center gap-2 text-xs font-semibold text-[var(--muted)]">
              <i class={`${IconClass} ui-icon`} style="font-size: 16px;" aria-hidden="true"></i>
              <span class="truncate">{item.label}</span>
            </p>
            <p class="font-display mt-2 truncate text-base font-bold text-[var(--text)] md:text-lg">
              {item.amountUsd ? formatUsd(item.amountUsd) : item.emptyLabel}
            </p>
          </div>
          );
        })
      }
    </div>

    <div class="grid grid-cols-2 gap-2 sm:w-72">
      <div class="grid gap-2">
        <a
          class="btn-secondary focus-ring min-h-12 px-4 text-sm"
          href="https://minipay.opera.com/"
        >
          <i class="fa-solid fa-plus ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
          Depositar
        </a>
        <p class="text-center text-[0.68rem] font-bold text-[var(--muted)]">Abre MiniPay</p>
      </div>
      <div class="grid gap-2">
        <a
          class="btn-gold focus-ring min-h-12 px-4 text-sm"
          href="/support"
        >
          <i class="fa-solid fa-arrow-down ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
          Sacar
        </a>
        <p class="text-center text-[0.68rem] font-bold text-[var(--muted)]">Via suporte no MVP</p>
      </div>
    </div>
  </div>
</section>
