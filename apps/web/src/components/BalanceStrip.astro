---
import { accountSummaryItems } from "../data/account";
import { formatUsd } from "../lib/format";
import { ArrowDown, Plus, Trophy, TrendingUp, Wallet } from "lucide-astro";

const icons = {
  balance: Wallet,
  "active-stake": TrendingUp,
  withdrawable: Trophy
} as const;
---

<section class="app-shell pt-4" aria-label="Conta MiniPay" transition:name="balance-strip">
  <div class="surface-panel grid gap-3 p-3 sm:grid-cols-[1fr_auto] sm:items-center">
    <div class="grid grid-cols-3 gap-2">
      {
        accountSummaryItems.map((item) => {
          const Icon = icons[item.id];
          return (
          <div class="rounded-[8px] border border-[var(--line)] bg-white/[0.035] p-3">
            <p class="flex min-w-0 items-center gap-1.5 text-xs font-semibold text-[var(--muted)]">
              <Icon size={14} aria-hidden="true" />
              <span class="truncate">{item.label}</span>
            </p>
            <p class="font-display mt-1 truncate text-base font-bold text-[var(--text)] md:text-lg">
              {item.amountUsd ? formatUsd(item.amountUsd) : item.emptyLabel}
            </p>
          </div>
          );
        })
      }
    </div>

    <div class="grid grid-cols-2 gap-2 sm:w-72">
      <div class="grid gap-1">
        <a
          class="btn-secondary focus-ring min-h-11 px-3 text-sm"
          href="https://minipay.opera.com/"
        >
          <Plus size={16} aria-hidden="true" />
          Depositar
        </a>
        <p class="text-center text-[0.68rem] font-bold text-[var(--muted)]">Abre MiniPay</p>
      </div>
      <div class="grid gap-1">
        <a
          class="btn-gold focus-ring min-h-11 px-3 text-sm"
          href="/support"
        >
          <ArrowDown size={16} aria-hidden="true" />
          Sacar
        </a>
        <p class="text-center text-[0.68rem] font-bold text-[var(--muted)]">Via suporte no MVP</p>
      </div>
    </div>
  </div>
</section>
