---
// Theme initialization script to prevent FOUC
---
<script is:inline>
  (() => {
    const storageKey = "project-ball-theme";
    let saved = null;
    let prefersLight = false;

    try {
      saved = localStorage.getItem(storageKey);
      prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
    } catch {
      prefersLight = false;
    }

    const theme = saved === "light" || saved === "dark" ? saved : prefersLight ? "light" : "dark";
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    const themeColor = getComputedStyle(document.documentElement).getPropertyValue("--color-theme-meta").trim();
    if (themeColor) {
      document.querySelector('meta[name="theme-color"]')?.setAttribute("content", themeColor);
    }

    const toggleLabel = theme === "light" ? "Usar modo escuro" : "Usar modo claro";
    for (const button of document.querySelectorAll("[data-theme-toggle]")) {
      button.setAttribute("aria-label", toggleLabel);
      button.setAttribute("title", toggleLabel);
    }
  })();
</script>
