---
// Theme initialization script to prevent FOUC
---
<script is:inline>
  (() => {
    const storageKey = "project-ball-theme";
    let saved = null;
    let prefersLight = false;

    try {
      saved = localStorage.getItem(storageKey);
      prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
    } catch {
      prefersLight = false;
    }

    const theme = saved === "light" || saved === "dark" ? saved : prefersLight ? "light" : "dark";
    const applyTheme = (newTheme) => {
      document.documentElement.dataset.theme = newTheme;
      document.documentElement.style.colorScheme = newTheme;
      const tc = getComputedStyle(document.documentElement).getPropertyValue("--color-theme-meta").trim();
      if (tc) {
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", tc);
      }
      const label = newTheme === "light" ? "Usar modo escuro" : "Usar modo claro";
      for (const btn of document.querySelectorAll("[data-theme-toggle]")) {
        btn.setAttribute("aria-label", label);
        btn.setAttribute("title", label);
      }
    };

    applyTheme(theme);

    try {
      window.matchMedia("(prefers-color-scheme: light)").addEventListener("change", (e) => {
        if (!localStorage.getItem(storageKey)) {
          applyTheme(e.matches ? "light" : "dark");
        }
      });
    } catch (err) {
      // ignore
    }
  })();
</script>
