---
const navItems = [
  { href: "/", label: "Partidas", icon: "fa-solid fa-futbol" },
  { href: "/meus-palpites", label: "Palpites", icon: "fa-solid fa-ticket" },
  { href: "/about", label: "Sobre", icon: "fa-solid fa-circle-question" },
  { href: "/support", label: "Suporte", icon: "fa-solid fa-headset" }
] as const;

const pathname = Astro.url.pathname;
---

<header class="app-shell sticky top-0 z-40 pt-3" transition:name="app-header" transition:persist>
  <div class="glass-panel nav-shell">
    <a class="brand-link focus-ring" href="/" aria-label="Project Ball">
      <span class="brand-mark" aria-hidden="true">J</span>
      <div class="min-w-0">
        <p class="text-[0.68rem] font-semibold uppercase text-[var(--gold)]">MiniPay</p>
        <p class="font-display truncate text-base font-bold leading-none text-[var(--text)]">Project Ball</p>
      </div>
    </a>

    <nav class="desktop-nav hide-scrollbar min-w-0 flex-1 justify-end gap-1 overflow-x-auto" aria-label="Principal">
      {
        navItems.map((item) => {
          const isActive = pathname === item.href;
          return (
            <a
              class="nav-link focus-ring"
              href={item.href}
              aria-current={isActive ? "page" : undefined}
              data-nav-link
            >
              <i class={`${item.icon} ui-icon`} style="font-size: 16px;" aria-hidden="true"></i>
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <div class="flex shrink-0 items-center gap-2">
      <button
        class="icon-button focus-ring"
        type="button"
        aria-label="Alternar tema"
        title="Alternar tema"
        data-theme-toggle
      >
        <i class="fa-solid fa-sun ui-icon" style="font-size: 16px;" aria-hidden="true" data-theme-icon="light"></i>
        <i class="fa-solid fa-moon ui-icon" style="font-size: 16px;" aria-hidden="true" data-theme-icon="dark"></i>
      </button>
      <div class="flex items-center gap-1.5" data-auth-guest>
        <a
          class="btn-secondary focus-ring min-h-10 px-3 text-[var(--green)]"
          href="/login"
        >
          <i class="fa-solid fa-right-to-bracket ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
          Login
        </a>
      </div>
      <div class="flex items-center gap-1.5" data-auth-user hidden>
        <a
          class="btn-secondary focus-ring min-h-10 max-w-32 px-3 text-[var(--green)]"
          href="/meus-palpites"
        >
          <i class="fa-solid fa-circle-check ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
          <span class="truncate" data-auth-address>Carteira</span>
        </a>
        <button
          class="icon-button focus-ring"
          type="button"
          aria-label="Sair"
          data-auth-logout
        >
          <i class="fa-solid fa-right-from-bracket ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>
</header>
