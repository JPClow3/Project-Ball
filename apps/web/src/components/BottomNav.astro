---
const items = [
  { href: "/", label: "Partidas", icon: "fa-solid fa-futbol" },
  { href: "/meus-palpites", label: "Palpites", icon: "fa-solid fa-ticket" },
  { href: "/about", label: "Sobre", icon: "fa-solid fa-circle-question" },
  { href: "/support", label: "Suporte", icon: "fa-solid fa-headset" }
] as const;
const current = Astro.url.pathname;
---

<nav class="mobile-nav" aria-label="Navegação inferior" transition:name="bottom-nav" transition:persist>
  <div class="mobile-nav-grid">
    {
      items.map((item) => {
        return (
          <a
            href={item.href}
            class="mobile-nav-link focus-ring"
            aria-current={current === item.href ? "page" : undefined}
            data-nav-link
          >
            <i class={`${item.icon} ui-icon`} style="font-size: 20px;" aria-hidden="true"></i>
            {item.label}
          </a>
        );
      })
    }
  </div>
</nav>
