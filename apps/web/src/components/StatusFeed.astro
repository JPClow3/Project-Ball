---
import { matches } from "../data/matches";
import { formatUsd } from "../lib/format";

const openMatches = matches.filter((match) => match.status === "open");
const nextMatch = openMatches[0];
const totalPoolUsd = matches.reduce((total, match) => total + Number.parseFloat(match.poolUsd), 0);
const totalSupporters = matches.reduce((total, match) => total + match.supporterCount, 0);

const feed = [
  {
    icon: "fa-solid fa-flag",
    label: "Próxima partida",
    value: nextMatch ? `${nextMatch.homeTeam} x ${nextMatch.awayTeam}` : "Sem partidas",
    tone: "text-[var(--green)]"
  },
  {
    icon: "fa-solid fa-users",
    label: "Palpites registrados",
    value: totalSupporters.toLocaleString("pt-BR"),
    tone: "text-[var(--gold)]"
  },
  {
    icon: "fa-solid fa-coins",
    label: "Pote total",
    value: formatUsd(totalPoolUsd),
    tone: "text-[var(--cyan)]"
  }
] as const;
---

<section class="app-shell pt-4" aria-label="Ritmo do app" transition:name="status-feed">
  <div class="grid gap-4 md:grid-cols-3">
    {
      feed.map((item) => {
        return (
          <div class="stat-tile">
            <p class="flex items-center gap-2 text-sm font-semibold text-[var(--muted)]">
              <i class={`${item.icon} ui-icon`} style="font-size: 16px;" aria-hidden="true"></i>
              {item.label}
            </p>
            <p class:list={["font-display mt-2 text-2xl font-bold", item.tone]}>{item.value}</p>
          </div>
        );
      })
    }
  </div>
</section>
