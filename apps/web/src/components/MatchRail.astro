---
import { matches as defaultMatches, type MatchViewModel } from "../data/matches";
import { formatKickoff, formatUsd } from "../lib/format";

import MatchCard from "./MatchCard.astro";
import { useTranslations } from "../i18n";

const t = useTranslations(Astro.locals.lang);

type Props = {
  matches?: readonly MatchViewModel[];
};

const { matches = defaultMatches } = Astro.props;

function groupId(label: string): string {
  return label.toLowerCase().replace(/\s+/g, "-");
}

const groups = [...new Set(matches.map((match) => match.groupLabel))].map((label) => {
  const groupMatches = matches.filter((match) => match.groupLabel === label);
  const poolUsd = groupMatches.reduce((total, match) => total + Number.parseFloat(match.poolUsd), 0);
  const supporters = groupMatches.reduce((total, match) => total + match.supporterCount, 0);

  return {
    id: groupId(label),
    label,
    matches: groupMatches,
    poolUsd,
    supporters,
    firstKickoffIso: groupMatches[0]?.kickoffIso ?? ""
  };
});

const now = Date.now();
const firstUpcomingGroup = groups.find((group) =>
  group.matches.some((match) => new Date(match.kickoffIso).getTime() > now)
);
const activeGroup = firstUpcomingGroup ?? groups[0];
---

<section id="match-board" class="app-shell page-stack py-6" aria-labelledby="partidas" transition:name="match-board">
  <div class="match-board-header">
    <div>
      <p class="eyebrow">{t("rail.stage")}</p>
      <h2 id="partidas" class="font-display mt-4 text-2xl font-bold text-[var(--text)] md:text-3xl">{t("rail.title")}</h2>
      <p class="mt-2 max-w-2xl text-sm font-semibold leading-relaxed text-[var(--muted)] md:text-base">
        {t("rail.desc")}
      </p>
    </div>
  </div>

  <div class="quick-filters hide-scrollbar" role="group" aria-label="Filtros rápidos">
    <button class="filter-chip focus-ring" type="button" data-filter-chip data-filter="all" aria-pressed="true">
      <i class="fa-solid fa-table-cells-large ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
      {t("filter.all")}
    </button>
    <button class="filter-chip focus-ring" type="button" data-filter-chip data-filter="today" aria-pressed="false">
      <i class="fa-solid fa-calendar-days ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
      {t("filter.today")}
    </button>
    <button class="filter-chip focus-ring" type="button" data-filter-chip data-filter="brazil" aria-pressed="false">
      <i class="fa-solid fa-star ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
      {t("filter.brazil")}
    </button>
    <button class="filter-chip focus-ring" type="button" data-filter-chip data-filter="soon" aria-pressed="false">
      <i class="fa-solid fa-bolt ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
      {t("filter.soon")}
    </button>
    <button class="filter-chip focus-ring" type="button" data-filter-chip data-filter="mine" aria-pressed="false" data-auth-user hidden>
      <i class="fa-solid fa-ticket ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
      {t("filter.mine")}
    </button>
  </div>

  <div class="group-tabs hide-scrollbar" role="tablist" aria-label="Grupos da Copa">
    {
      groups.map((group) => {
        const isActive = group.id === activeGroup?.id;
        return (
          <button
            id={`tab-${group.id}`}
            class="group-tab focus-ring"
            type="button"
            role="tab"
            aria-selected={isActive ? "true" : "false"}
            aria-controls={`panel-${group.id}`}
            tabindex={isActive ? "0" : "-1"}
            data-group-tab
            data-group-id={group.id}
          >
            <span>{group.label.replace("Grupo ", "")}</span>
          </button>
        );
      })
    }
  </div>

  <div class="grid gap-8">
    {
      groups.map((group) => {
        const [featuredMatch, ...restMatches] = group.matches;
        const isActive = group.id === activeGroup?.id;

        return (
          <section
            id={`panel-${group.id}`}
            class="group-panel"
            role="tabpanel"
            aria-labelledby={`tab-${group.id}`}
            hidden={!isActive}
            data-group-panel
            data-group-id={group.id}
            transition:name={`group-panel-${group.id}`}
          >
            <div class="group-summary">
              <div>
                <p class="text-xs font-semibold uppercase text-[var(--gold)]">{group.label}</p>
                <p class="mt-2 text-sm font-semibold text-[var(--muted)]">
                  Primeiro jogo: {featuredMatch ? formatKickoff(featuredMatch.kickoffIso) : "Calendário pendente"}
                </p>
              </div>
              <div class="grid grid-cols-2 gap-2 text-right sm:w-72">
                <div>
                  <p class="text-xs font-bold text-[var(--muted)]">Pote do grupo</p>
                  <p class="font-display text-lg font-bold text-[var(--text)]">{formatUsd(group.poolUsd)}</p>
                </div>
                <div>
                  <p class="text-xs font-bold text-[var(--muted)]">Palpites</p>
                  <p class="font-display text-lg font-bold text-[var(--text)]">{group.supporters.toLocaleString("pt-BR")}</p>
                </div>
              </div>
            </div>

            <div class="match-grid">
              {featuredMatch && <MatchCard match={featuredMatch} featured={true} loading={isActive ? "eager" : "lazy"} />}
              {restMatches.map((match) => <MatchCard match={match} compact loading="lazy" />)}
            </div>
            <div class="filter-empty mt-4" data-filter-empty hidden>
              <i class="fa-solid fa-futbol ui-icon text-[var(--gold)]" style="font-size: 24px;" aria-hidden="true"></i>
              <div>
                <h3 class="font-display text-xl font-bold text-[var(--text)]">Próximas partidas chegam em breve ⚽</h3>
                <p class="mt-2 text-sm font-medium text-[var(--muted)]">Não há partidas abertas correspondentes no momento.</p>
              </div>
              <button class="btn-secondary focus-ring w-fit" type="button" data-filter-reset>
                Ver todas as partidas
              </button>
            </div>
          </section>
        );
      })
    }
  </div>
</section>
