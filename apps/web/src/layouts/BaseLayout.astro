---
import { ClientRouter } from "astro:transitions";
import ThemeInit from "../components/ThemeInit.astro";
import BottomNav from "../components/BottomNav.astro";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Project Ball",
  description = "Palpites de futebol com dólar digital na MiniPay."
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="Canvas" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/p9sAAAAASUVORK5CYII=" />
    <ThemeInit />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <title>{title}</title>
    <ClientRouter />
    <script>
      import "../scripts/place-bet";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para conteúdo</a>
    <slot />
    <BottomNav />
  </body>
</html>
