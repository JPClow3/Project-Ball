---
import { ClientRouter } from "astro:transitions";
import BottomNav from "../components/BottomNav.astro";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "Jonakinho",
  description = "Palpites de futebol com dólar digital na MiniPay."
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#090b0f" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/p9sAAAAASUVORK5CYII=" />
    <script is:inline>
      (() => {
        const storageKey = "jonakinho-theme";
        let saved = null;
        let prefersLight = false;

        try {
          saved = localStorage.getItem(storageKey);
          prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        } catch {
          prefersLight = false;
        }

        const theme = saved === "light" || saved === "dark" ? saved : prefersLight ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "light" ? "#f5f7fb" : "#090b0f");
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script>
      import "../scripts/place-bet";
    </script>
  </head>
  <body>
    <slot />
    <BottomNav />
  </body>
</html>
