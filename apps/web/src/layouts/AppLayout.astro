---
import { ClientRouter } from "astro:transitions";
import ThemeInit from "@/components/ThemeInit.astro";
import AppHeader from "@/components/AppHeader.astro";
import BottomNav from "@/components/BottomNav.astro";
import "@/styles/global.css";

type Props = {
  title?: string;
};

const title = Astro.props.title ? `${Astro.props.title} | Project Ball` : "Project Ball";
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="Canvas" />
    <meta name="description" content="Palpites rápidos de futebol na Celo, feitos para MiniPay." />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+/p9sAAAAASUVORK5CYII=" />
    <ThemeInit />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para conteúdo</a>
    <AppHeader />
    <main id="conteudo" class="app-shell app-main" transition:name="page-content">
      <slot />
    </main>
    <BottomNav />
    <script>
      import "../scripts/place-bet";
    </script>
  </body>
</html>
