---
import BaseLayout from "./BaseLayout.astro";
import AppHeader from "@/components/AppHeader.astro";
import PageFooter from "@/components/PageFooter.astro";

type Props = {
  title?: string;
  description?: string;
  mainClass?: string;
  isFluid?: boolean;
};

const {
  title: pageTitle,
  description = "Palpites rápidos de futebol na Celo, feitos para MiniPay.",
  mainClass = "",
  isFluid = false
} = Astro.props;

const title = pageTitle ? `${pageTitle} | Project Ball` : "Project Ball";
---

<BaseLayout title={title} description={description}>
  <AppHeader />
  <main
    id="conteudo"
    class:list={[
      !isFluid && "app-shell app-main",
      mainClass
    ]}
    transition:name="page-content"
  >
    <slot />
  </main>
  <PageFooter />
</BaseLayout>

