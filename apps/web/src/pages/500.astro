---
import AppLayout from "../layouts/AppLayout.astro";

interface Props {
  error: unknown;
}

const { error } = Astro.props;

// Safe logging on the server side
console.error("Server-side Error Caught by 500.astro:", error);
---

<AppLayout title="Instabilidade temporária" mainClass="flex flex-col justify-center items-center text-center">
  <section class="surface-panel p-8 max-w-md w-full flex flex-col items-center gap-6 my-12">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-white/[0.05] border border-[var(--line-strong)] text-[var(--coral)] animate-pulse">
      <i class="fa-solid fa-triangle-exclamation ui-icon text-3xl" aria-hidden="true"></i>
    </div>
    <div>
      <p class="text-xs font-black uppercase text-[var(--coral)] tracking-wider">Erro 500</p>
      <h1 class="font-display mt-2 text-3xl font-extrabold text-[var(--text)]">Instabilidade temporária</h1>
      <p class="mt-4 text-sm font-semibold leading-relaxed text-[var(--muted)]">
        Ocorreu um erro inesperado em nosso servidor. Nosso sistema de cache ou conexão de rede pode estar fora do ar.
      </p>
    </div>
    <div class="w-full border-t border-[var(--line)] my-2"></div>
    <div class="flex flex-col gap-3 w-full">
      <button class="btn-primary focus-ring w-full justify-center" onclick="window.location.reload()">
        <i class="fa-solid fa-rotate ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
        Tentar novamente
      </button>
      <a class="btn-secondary focus-ring w-full justify-center" href="/">
        <i class="fa-solid fa-house ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
        Voltar ao início
      </a>
    </div>
  </section>
</AppLayout>
