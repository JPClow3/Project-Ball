---
import MatchCard from "@/components/MatchCard.astro";
import AppLayout from "@/layouts/AppLayout.astro";
import { getSession } from "@/lib/auth";
import { getUserConfirmedPicks } from "@/lib/bets";
import { formatKickoff } from "@/lib/format";
import { getMatch, withUserPick } from "@/lib/matches";
import { getDefaultStablecoin } from "@/lib/tokens";
import { getRuntimeEnv } from "@/lib/runtime";
import { useTranslations } from "@/i18n";

const env = getRuntimeEnv();
const t = useTranslations(Astro.locals.lang);

let session = null;
try {
  session = await getSession(env.PROJECT_BALL_DB, Astro.request);
} catch (error) {
  console.warn("Database is offline. Unable to fetch session for meus-palpites page.", error);
}

if (!session) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}

let confirmedPicks: any[] = [];
try {
  confirmedPicks = [...await getUserConfirmedPicks(env.PROJECT_BALL_DB, session.user.walletAddress)];
} catch (error) {
  console.warn("Database is offline. Falling back to empty confirmed picks list.", error);
}

const activePicks = confirmedPicks.flatMap((pick) => {
  const match = getMatch(pick.matchId);
  return match ? [withUserPick(match, pick.outcome)] : [];
});
const accountLabel = session.user.displayName ?? "Carteira conectada";
const defaultToken = getDefaultStablecoin();
---

<AppLayout
  title={t("picks.title")}
  description={t("picks.desc")}
>
  <section class="page-stack">
    <section class="page-hero">
      <div class="page-hero-row">
        <div>
          <p class="eyebrow">
            <i class="fa-solid fa-ticket ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
            {accountLabel}
          </p>
          <h1 class="page-title mt-4">{t("picks.title")}</h1>
          <p class="page-copy mt-4 text-lg">
            {t("picks.desc")}
          </p>
        </div>
        <div class="quiet-meta-grid">
          <div class="quiet-meta">
            <span>{t("picks.active")}</span>
            <strong class="text-xl">{activePicks.length.toLocaleString("pt-BR")}</strong>
          </div>
          <div class="quiet-meta">
            <span>{t("picks.default")}</span>
            <strong class="text-xl">{defaultToken.label}</strong>
          </div>
          <div class="quiet-meta">
            <span>{t("picks.status")}</span>
            <strong class="text-xl">{activePicks.length > 0 ? t("picks.statusWaiting") : t("picks.statusEmpty")}</strong>
          </div>
        </div>
      </div>
    </section>

    <section class="picks-layout" aria-label="Área de palpites">
      <div class="pick-column">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="match-label">{t("picks.currentRound")}</p>
            <h2 class="mt-2 text-2xl font-bold">{activePicks.length === 0 ? t("picks.statusEmpty") : activePicks.length > 1 ? t("picks.yourPicks") : t("picks.yourPick")}</h2>
          </div>
          <a class="btn-secondary focus-ring min-h-12 w-fit px-5 font-bold" href="/">
            <i class="fa-solid fa-futbol ui-icon" style="font-size: 18px;" aria-hidden="true"></i>
            {t("picks.viewMatches")}
          </a>
        </div>

        {
          activePicks.length > 0 ? (
            <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6">
              {activePicks.map((pick) => (
                <MatchCard match={pick} compact />
              ))}
            </div>
          ) : (
            <div class="empty-state-panel mt-6 p-10 border border-[var(--border)] rounded-2xl bg-[var(--surface-variant)] flex flex-col items-center justify-center text-center">
              <i class="fa-solid fa-wallet ui-icon text-[var(--gold)] mb-4" style="font-size: 48px;" aria-hidden="true"></i>
              <div>
                <h3 class="font-display text-2xl font-extrabold text-[var(--text)]">{t("picks.noPicks")}</h3>
                <p class="mt-3 text-base font-medium leading-relaxed text-[var(--muted)] max-w-sm mx-auto">
                  {t("picks.noPicksDesc")}
                </p>
              </div>
              <a class="btn-primary focus-ring mt-8 px-6 py-3 text-lg" href="/">
                {t("picks.viewMatches")}
                <i class="fa-solid fa-arrow-right ui-icon" style="font-size: 18px;" aria-hidden="true"></i>
              </a>
            </div>
          )
        }
      </div>

      <aside class="quiet-card bg-[rgba(255,255,255,0.02)] border border-[rgba(255,255,255,0.06)] backdrop-blur-xl rounded-2xl p-6 lg:p-8">
        <p class="match-label">{t("picks.afterConfirmation")}</p>
        <h2 class="text-2xl font-bold mt-2 mb-8">{t("picks.tracking")}</h2>
        <div class="timeline-list flex flex-col gap-8 relative before:absolute before:inset-y-0 before:left-5 before:w-px before:bg-[var(--border)]">
          <article class="timeline-item flex gap-6 relative">
            <span class="liquid-icon w-10 h-10 rounded-full bg-[var(--surface-muted)] flex items-center justify-center shrink-0 border border-[var(--border)] relative z-10"><i class="fa-solid fa-clock ui-icon text-[var(--muted-strong)]" style="font-size: 18px;" aria-hidden="true"></i></span>
            <div class="pt-1.5">
              <h3 class="text-lg font-bold text-[var(--text)]">{t("picks.matchLock")}</h3>
              <p class="text-sm text-[var(--muted)] mt-1.5 leading-relaxed">{activePicks[0] ? formatKickoff(activePicks[0].kickoffIso) : t("picks.matchLockDesc")}</p>
            </div>
          </article>
          <article class="timeline-item flex gap-6 relative">
            <span class="liquid-icon w-10 h-10 rounded-full bg-[var(--surface-muted)] flex items-center justify-center shrink-0 border border-[var(--border)] relative z-10"><i class="fa-solid fa-futbol ui-icon text-[var(--muted-strong)]" style="font-size: 18px;" aria-hidden="true"></i></span>
            <div class="pt-1.5">
              <h3 class="text-lg font-bold text-[var(--text)]">{t("picks.resultConfirmed")}</h3>
              <p class="text-sm text-[var(--muted)] mt-1.5 leading-relaxed">{t("picks.resultConfirmedDesc")}</p>
            </div>
          </article>
          <article class="timeline-item flex gap-6 relative">
            <span class="liquid-icon w-10 h-10 rounded-full bg-[var(--surface-muted)] flex items-center justify-center shrink-0 border border-[var(--border)] relative z-10"><i class="fa-solid fa-wallet ui-icon text-[var(--muted-strong)]" style="font-size: 18px;" aria-hidden="true"></i></span>
            <div class="pt-1.5">
              <h3 class="text-lg font-bold text-[var(--text)]">{t("picks.withdrawal")}</h3>
              <p class="text-sm text-[var(--muted)] mt-1.5 leading-relaxed">{t("picks.withdrawalDesc")}</p>
            </div>
          </article>
        </div>
      </aside>
    </section>
  </section>
</AppLayout>
