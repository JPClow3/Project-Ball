---
import AppHeader from "../components/AppHeader.astro";
import PageFooter from "../components/PageFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { FileText } from "lucide-astro";
---

<BaseLayout title="Jonakinho | Termos">
  <AppHeader />
  <main class="app-shell app-main" transition:name="page-content">
    <article class="surface-panel max-w-3xl p-5 leading-relaxed md:p-6" transition:name="legal-content">
      <p class="eyebrow">
        <FileText size={14} aria-hidden="true" />
        Legal
      </p>
      <h1 class="font-display mt-4 text-3xl font-extrabold text-[var(--text)]">Termos de uso</h1>
      <p class="mt-5 text-[var(--muted)]">
        Jonakinho é um MVP de palpites em partidas de futebol com dólar digital na rede Celo. Cada carteira pode fazer um palpite por partida. A partida trava antes do início informado.
      </p>
      <p class="mt-4 text-[var(--muted)]">
        Partidas canceladas, adiadas sem resolução ou sem vencedores elegíveis podem ser marcadas como anuladas e liberar reembolso proporcional conforme o contrato.
      </p>
    </article>
  </main>
  <PageFooter />
</BaseLayout>
