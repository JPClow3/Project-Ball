---
import { env } from "cloudflare:workers";
import AppHeader from "../components/AppHeader.astro";
import PageFooter from "../components/PageFooter.astro";
import { formatUsd } from "../lib/format";
import { getStats, getTokenVolumes } from "../lib/stats";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ArrowRightLeft, Calendar, ChartColumn, Coins, Database, Sun, TriangleAlert, Users } from "lucide-astro";

const statsSnapshot = await getStats(env);
const tokenVolumes = await getTokenVolumes(env);
const stats = [
  { label: "DAU", value: statsSnapshot.dailyActiveUsers.toLocaleString("pt-BR"), icon: Sun, tone: "text-[var(--green)]" },
  { label: "MAU", value: statsSnapshot.monthlyActiveUsers.toLocaleString("pt-BR"), icon: Calendar, tone: "text-[var(--gold)]" },
  { label: "Transações", value: statsSnapshot.transactionCount.toLocaleString("pt-BR"), icon: ArrowRightLeft, tone: "text-[var(--cyan)]" },
  { label: "Usuários on-chain", value: statsSnapshot.uniqueOnchainUsers.toLocaleString("pt-BR"), icon: Users, tone: "text-[var(--violet)]" },
  { label: "Volume", value: formatUsd(statsSnapshot.volumeUsd), icon: Coins, tone: "text-[var(--green)]" },
  { label: "Falhas", value: statsSnapshot.failedTransactionRate, icon: TriangleAlert, tone: "text-[var(--coral)]" }
] as const;
---

<BaseLayout title="Jonakinho | Números">
  <AppHeader />
  <main class="app-shell app-main page-stack" transition:name="page-content">
    <section class="surface-panel p-5 md:p-6" transition:name="stats-hero">
      <p class="eyebrow">
        <ChartColumn size={14} aria-hidden="true" />
        Público
      </p>
      <h1 class="font-display mt-4 text-3xl font-extrabold text-[var(--text)] md:text-4xl">Números do Jonakinho</h1>
      <p class="lede mt-3">
        Atividade, volume, usuários únicos, saúde das transações e distribuição por dólar digital.
      </p>
    </section>

    <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" aria-label="Indicadores">
      {
        stats.map((item, index) => {
          const Icon = item.icon;
          return (
            <div class="stat-tile" style={`animation-delay: ${index * 45}ms`}>
              <p class="flex items-center gap-2 text-sm font-extrabold text-[var(--muted)]">
                <Icon size={16} class={item.tone} aria-hidden="true" />
                {item.label}
              </p>
              <p class:list={["stat-value", item.tone]}>{item.value}</p>
            </div>
          );
        })
      }
    </section>

    <section class="surface-panel p-4 md:p-5" aria-label="Volume por dólar digital">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="text-xs font-black uppercase text-[var(--gold)]">Tokens</p>
          <h2 class="font-display mt-1 text-xl font-extrabold text-[var(--text)]">Volume por dólar digital</h2>
        </div>
        <span class="status-pill status-pill--open">
          <Database size={14} aria-hidden="true" />
          D1 cache
        </span>
      </div>
      <div class="mt-5 grid gap-4">
        {
          tokenVolumes.map((token) => {
            const barWidth = token.share > 0 ? token.share : 5;

            return (
              <div class="volume-row">
                <div class="flex justify-between gap-3 text-sm font-extrabold">
                  <span class="text-[var(--text)]">{token.symbol}</span>
                  <span class="text-[var(--muted)]">{formatUsd(token.amountUsd)}</span>
                </div>
                <div class="volume-track">
                  <div
                    class:list={["volume-bar", token.share === 0 && "opacity-45"]}
                    style={`--bar-width: ${barWidth}%`}
                    aria-hidden="true"
                  >
                  </div>
                </div>
              </div>
            );
          })
        }
      </div>
    </section>
  </main>
  <PageFooter />
</BaseLayout>
