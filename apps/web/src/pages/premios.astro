---
import { env } from "cloudflare:workers";
import AppLayout from "@/layouts/AppLayout.astro";
import { getSession } from "@/lib/auth";

const session = await getSession(env.PROJECT_BALL_DB, Astro.request);
if (!session) {
  return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
}
---

<AppLayout title="Prêmios">
  <section class="page-stack">
    <div class="surface-panel p-6">
      <p class="eyebrow">
        <i class="fa-solid fa-trophy ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
        Prêmios
      </p>
      <h1 class="font-display mt-4 text-3xl font-extrabold leading-tight text-[var(--text)]">Disponíveis</h1>
      <p class="mt-2 max-w-2xl text-sm font-semibold leading-relaxed text-[var(--muted)]">
        Quando uma partida for resolvida, valores elegíveis aparecem aqui para saque.
      </p>
    </div>

    <section class="empty-state-panel">
      <i class="fa-solid fa-trophy ui-icon text-[var(--gold)]" style="font-size: 24px;" aria-hidden="true"></i>
      <div>
        <h2 class="font-display text-xl font-bold text-[var(--text)]">Nenhum saque disponível agora</h2>
        <p class="mt-2 max-w-prose text-sm font-medium leading-relaxed text-[var(--muted)]">Continue acompanhando os jogos confirmados para liberar prêmios.</p>
      </div>
      <a class="btn-gold focus-ring w-fit" href="/">
          <i class="fa-solid fa-futbol ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
          Ver jogos
      </a>
    </section>
  </section>
</AppLayout>
