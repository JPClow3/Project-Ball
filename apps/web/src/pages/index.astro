---
import MatchRail from "../components/MatchRail.astro";
import { matches } from "../data/matches";
import { tournamentConfig } from "../data/tournament";
import { getSession } from "../lib/auth";
import { getUserConfirmedPicks } from "../lib/bets";
import { formatKickoffFull } from "../lib/format";
import { withUserPick } from "../lib/matches";
import AppLayout from "../layouts/AppLayout.astro";
import { getRuntimeEnv } from "../lib/runtime";
import { useTranslations } from "../i18n";

const env = getRuntimeEnv();
const t = useTranslations(Astro.locals.lang);

const groupCount = new Set(matches.map((match) => match.groupLabel)).size;
const now = Date.now();
const nextMatch = matches.find((match) => new Date(match.kickoffIso).getTime() > now) ?? matches[0];
const msUntilNext = nextMatch ? new Date(nextMatch.kickoffIso).getTime() - now : 0;
const hoursUntilNext = Math.max(0, Math.ceil(msUntilNext / (1000 * 60 * 60)));
const countdownLabel = hoursUntilNext >= 48
  ? `${Math.ceil(hoursUntilNext / 24)} ${t("hero.days")}`
  : hoursUntilNext > 0
    ? `${hoursUntilNext} ${t("hero.hours")}`
    : t("hero.live");
const nextHomeFlag = nextMatch?.homeFlagCode ? `https://flagcdn.com/w40/${nextMatch.homeFlagCode}.png` : "";
const nextAwayFlag = nextMatch?.awayFlagCode ? `https://flagcdn.com/w40/${nextMatch.awayFlagCode}.png` : "";
const heroFlags = [
  ...new Map(
    matches
      .flatMap((match) => {
        const list = [];
        if (match.homeFlagCode) list.push([match.homeFlagCode, match.homeCountry] as const);
        if (match.awayFlagCode) list.push([match.awayFlagCode, match.awayCountry] as const);
        return list;
      })
      .map(([code, country]) => [code, { code, country }])
  ).values()
].slice(0, 10);


let session = null;
let confirmedPicks: any[] = [];
try {
  session = await getSession(env.PROJECT_BALL_DB, Astro.request);
  if (session) {
    confirmedPicks = [...await getUserConfirmedPicks(env.PROJECT_BALL_DB, session.user.walletAddress)];
  }
} catch (error) {
  console.warn("Database is offline. Falling back to guest/in-memory mode for homepage rendering.", error);
}

const confirmedPickByMatchId = new Map(confirmedPicks.map((pick) => [pick.matchId, pick.outcome]));
const matchBoard = matches.map((match) => withUserPick(match, confirmedPickByMatchId.get(match.id)));
---

<meta
  name="talentapp:project_verification"
  content="16e92412978e6de6dfeb1f271a079e0d34daa1594e3d34e77c0f611ca77d8fad71e48e8c63fb952220a8a661e32daaaf8acb062d26023f740c3ef5b732668368"
/>

<AppLayout title={t("nav.picks")} isFluid={true}>
  <div class="app-shell mb-6">
    <div class="relative overflow-hidden bg-[#0c1523] border border-[var(--glass-border,rgba(255,255,255,0.07))] rounded-2xl md:rounded-[24px]">
      <svg class="absolute -right-[110px] -top-[90px] opacity-[0.055] pointer-events-none" width="440" height="380" viewBox="0 0 440 380" aria-hidden="true">
        <circle cx="220" cy="180" r="170" stroke="white" stroke-width="1.5" fill="none"/>
        <circle cx="220" cy="180" r="12" stroke="white" stroke-width="1.5" fill="none"/>
        <line x1="50" y1="180" x2="390" y2="180" stroke="white" stroke-width="1"/>
        <rect x="150" y="110" width="140" height="140" stroke="white" stroke-width="1" fill="none"/>
        <rect x="175" y="135" width="90" height="90" stroke="white" stroke-width="1" fill="none"/>
      </svg>

      <div class="relative z-10 p-4 md:p-6 lg:p-8 flex flex-col lg:flex-row gap-6 lg:gap-8 items-start lg:items-center">
        <div class="flex-1">
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="bg-[rgba(255,255,255,0.06)] text-[var(--muted)] text-[9px] px-2 py-1 rounded tracking-[0.6px] uppercase font-bold">Project Ball</span>
            <span class="bg-[color-mix(in_srgb,var(--green)_10%,transparent)] border border-[color-mix(in_srgb,var(--green)_22%,transparent)] text-[var(--green)] text-[9px] px-2 py-1 rounded tracking-[0.6px] uppercase font-bold">{tournamentConfig.name}</span>
          </div>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-normal text-white leading-tight mb-5">
            Football without <br class="hidden sm:block" /><span class="text-[var(--green)] font-semibold">the fluff.</span>
          </h1>

          <p class="text-[var(--muted)] text-base lg:text-lg leading-relaxed mb-8 max-w-md lg:max-w-lg">
            {t("hero.subtitle")}
          </p>

          <div class="flex flex-wrap gap-2 mb-8 text-xl">
            {heroFlags.slice(0, 10).map((flag, index) => (
              <img
                src={`https://flagcdn.com/w40/${flag.code}.png`}
                alt={`Bandeira: ${flag.country}`}
                class="w-6 h-auto rounded-[2px]"
                loading={index < 4 ? "eager" : "lazy"}
                decoding="async"
              />
            ))}
          </div>

          <div class="flex flex-wrap gap-4">
            <div class="bg-[rgba(255,255,255,0.04)] border border-[rgba(255,255,255,0.07)] rounded-xl px-5 py-3.5 lg:px-6 lg:py-4 min-w-[100px] lg:min-w-[120px]">
              <div class="text-[var(--text)] text-3xl lg:text-4xl font-bold leading-none mb-1">{matches.length}</div>
              <div class="text-[var(--muted-strong)] text-[10px] tracking-wider uppercase font-medium">{t("hero.matches")}</div>
            </div>
            <div class="bg-[rgba(255,255,255,0.04)] border border-[rgba(255,255,255,0.07)] rounded-xl px-5 py-3.5 lg:px-6 lg:py-4 min-w-[100px] lg:min-w-[120px]">
              <div class="text-[var(--text)] text-3xl lg:text-4xl font-bold leading-none mb-1">{groupCount}</div>
              <div class="text-[var(--muted-strong)] text-[10px] tracking-wider uppercase font-medium">{t("hero.groups")}</div>
            </div>
            <div class="bg-[color-mix(in_srgb,var(--green)_6%,transparent)] border border-[color-mix(in_srgb,var(--green)_18%,transparent)] rounded-xl px-5 py-3.5 lg:px-6 lg:py-4 min-w-[120px] lg:min-w-[140px]">
              <div class="text-[var(--green)] text-3xl lg:text-4xl font-bold leading-none mb-1">{countdownLabel}</div>
              <div class="text-[var(--green)] opacity-70 text-[10px] tracking-wider uppercase font-medium">Para fechar</div>
            </div>
          </div>
        </div>

        {nextMatch && (
          <div class="w-full lg:w-[260px] bg-[rgba(255,255,255,0.04)] border border-[rgba(255,255,255,0.08)] rounded-[16px] p-4 flex-shrink-0">
            <div class="flex justify-between items-center mb-4">
              <span class="text-[var(--muted-strong)] text-[9px] tracking-wider font-semibold uppercase">{t("ticket.nextMatch")}</span>
              <span class="bg-[color-mix(in_srgb,var(--green)_10%,transparent)] border border-[color-mix(in_srgb,var(--green)_25%,transparent)] text-[var(--green)] text-[9px] font-bold px-2.5 py-1 rounded-full">{countdownLabel}</span>
            </div>
            
            <div class="flex items-center justify-between mb-4 px-2">
              <div class="text-center flex flex-col items-center">
                {nextHomeFlag && <img src={nextHomeFlag} alt={nextMatch.homeCountry} class="w-8 h-auto mb-1.5 rounded-[2px]" />}
                <div class="text-[var(--text)] text-[10px] font-medium leading-tight max-w-[80px] truncate">{nextMatch.homeTeam}</div>
              </div>
              <div class="bg-[rgba(255,255,255,0.1)] border border-[rgba(255,255,255,0.15)] text-[var(--muted-strong)] text-xs font-bold px-3 py-1 rounded-full">VS</div>
              <div class="text-center flex flex-col items-center">
                {nextAwayFlag && <img src={nextAwayFlag} alt={nextMatch.awayCountry} class="w-8 h-auto mb-1.5 rounded-[2px]" />}
                <div class="text-[var(--text)] text-[10px] font-medium leading-tight max-w-[80px] truncate">{nextMatch.awayTeam}</div>
              </div>
            </div>

            <div class="border-t border-[rgba(255,255,255,0.06)] pt-3">
              <div class="text-[var(--muted-strong)] text-[10px] mb-0.5">{nextMatch ? formatKickoffFull(nextMatch.kickoffIso) : t("ticket.pending")}</div>
              <div class="text-[var(--muted)] text-[10px] mb-3 truncate">{nextMatch.venue}</div>
              
              <div class="grid grid-cols-3 gap-1">
                <div class="bg-[color-mix(in_srgb,#3b82f6_10%,transparent)] border border-[color-mix(in_srgb,#3b82f6_28%,transparent)] rounded-lg py-1.5 px-1 text-center">
                  <div class="text-[#93c5fd] text-[9px] font-semibold truncate">{nextMatch.homeTeam}</div>
                </div>
                <div class="bg-[rgba(255,255,255,0.03)] border border-[rgba(255,255,255,0.07)] rounded-lg py-1.5 px-1 text-center">
                  <div class="text-[var(--muted-strong)] text-[9px] truncate">{t("ticket.draw")}</div>
                </div>
                <div class="bg-[color-mix(in_srgb,#06b6d4_10%,transparent)] border border-[color-mix(in_srgb,#06b6d4_28%,transparent)] rounded-lg py-1.5 px-1 text-center">
                  <div class="text-[#67e8f9] text-[9px] font-semibold truncate">{nextMatch.awayTeam}</div>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>

      <div class="h-1 bg-[var(--green)] w-full"></div>
    </div>
  </div>

  <MatchRail matches={matchBoard} />
</AppLayout>
