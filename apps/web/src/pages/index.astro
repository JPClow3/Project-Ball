---
import MatchRail from "../components/MatchRail.astro";
import { matches } from "../data/matches";
import { tournamentConfig } from "../data/tournament";
import { getSession } from "../lib/auth";
import { getUserConfirmedPicks } from "../lib/bets";
import { formatKickoffFull } from "../lib/format";
import { withUserPick } from "../lib/matches";
import AppLayout from "../layouts/AppLayout.astro";
import { getRuntimeEnv } from "../lib/runtime";
import { useTranslations } from "../i18n";

const env = getRuntimeEnv();
const t = useTranslations(Astro.locals.lang);

const groupCount = new Set(matches.map((match) => match.groupLabel)).size;
const now = Date.now();
const nextMatch = matches.find((match) => new Date(match.kickoffIso).getTime() > now) ?? matches[0];
const msUntilNext = nextMatch ? new Date(nextMatch.kickoffIso).getTime() - now : 0;
const hoursUntilNext = Math.max(0, Math.ceil(msUntilNext / (1000 * 60 * 60)));
const countdownLabel = hoursUntilNext >= 48
  ? `${Math.ceil(hoursUntilNext / 24)} ${t("hero.days")}`
  : hoursUntilNext > 0
    ? `${hoursUntilNext} ${t("hero.hours")}`
    : t("hero.live");
const nextHomeFlag = nextMatch?.homeFlagCode ? `https://flagcdn.com/w80/${nextMatch.homeFlagCode}.png` : "";
const nextAwayFlag = nextMatch?.awayFlagCode ? `https://flagcdn.com/w80/${nextMatch.awayFlagCode}.png` : "";
const heroFlags = [
  ...new Map(
    matches
      .flatMap((match) => {
        const list = [];
        if (match.homeFlagCode) list.push([match.homeFlagCode, match.homeCountry] as const);
        if (match.awayFlagCode) list.push([match.awayFlagCode, match.awayCountry] as const);
        return list;
      })
      .map(([code, country]) => [code, { code, country }])
  ).values()
].slice(0, 10);
const scheduleVerifiedLabel = new Intl.DateTimeFormat("pt-BR", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
  timeZone: tournamentConfig.displayTimeZone
}).format(new Date(`${tournamentConfig.scheduleVerifiedAt}T12:00:00Z`));

let session = null;
let confirmedPicks: any[] = [];
try {
  session = await getSession(env.PROJECT_BALL_DB, Astro.request);
  if (session) {
    confirmedPicks = [...await getUserConfirmedPicks(env.PROJECT_BALL_DB, session.user.walletAddress)];
  }
} catch (error) {
  console.warn("Database is offline. Falling back to guest/in-memory mode for homepage rendering.", error);
}

const confirmedPickByMatchId = new Map(confirmedPicks.map((pick) => [pick.matchId, pick.outcome]));
const matchBoard = matches.map((match) => withUserPick(match, confirmedPickByMatchId.get(match.id)));
---

<meta
  name="talentapp:project_verification"
  content="16e92412978e6de6dfeb1f271a079e0d34daa1594e3d34e77c0f611ca77d8fad71e48e8c63fb952220a8a661e32daaaf8acb062d26023f740c3ef5b732668368"
/>

<AppLayout title={t("nav.picks")} isFluid={true}>
  <section class="board-masthead matchday-hero" transition:name="page-hero">
    <div class="app-shell board-masthead-inner matchday-hero-grid">
      <div class="board-title-block matchday-copy">
        <p class="matchday-stamp">
          <span>{t("hero.kicker")}</span>
          <strong>{tournamentConfig.name}</strong>
        </p>
        <h1 class="board-title">{t("hero.title")}</h1>
        <p class="board-subtitle">
          {t("hero.subtitle")}
        </p>
        <div class="hero-flag-strip" aria-hidden="true">
          {heroFlags.map((flag) => (
            <img
              src={`https://flagcdn.com/w80/${flag.code}.png`}
              alt={`Bandeira: ${flag.country}`}
              width="30"
              height="22"
              loading="eager"
              decoding="async"
            />
          ))}
        </div>
        <div class="hero-command-row" aria-label="Resumo das partidas">
          <span><strong>{matches.length}</strong> {t("hero.matches")}</span>
          <span><strong>{groupCount}</strong> {t("hero.groups")}</span>
          <span><strong>{countdownLabel}</strong> {t("hero.untilLock")}</span>
        </div>
      </div>

      <aside class="matchday-ticket" aria-label={t("ticket.nextMatch")}>
        <div class="ticket-topbar">
          <span>{t("ticket.nextMatch")}</span>
          <strong>{countdownLabel}</strong>
        </div>
        {
          nextMatch && (
            <div class="ticket-fixture">
              <div class="ticket-team">
                {nextHomeFlag && (
                  <img
                    src={nextHomeFlag}
                    alt=""
                    aria-hidden="true"
                    width="34"
                    height="24"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                )}
                <strong>{nextMatch.homeTeam}</strong>
                <span>{nextMatch.homeCountry}</span>
              </div>
              <span class="ticket-versus">vs</span>
              <div class="ticket-team">
                {nextAwayFlag && (
                  <img
                    src={nextAwayFlag}
                    alt=""
                    aria-hidden="true"
                    width="34"
                    height="24"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                  />
                )}
                <strong>{nextMatch.awayTeam}</strong>
                <span>{nextMatch.awayCountry}</span>
              </div>
            </div>
          )
        }
        <div class="ticket-meta-grid">
          <span>
            <small>{t("ticket.lock")}</small>
            <strong>{nextMatch ? formatKickoffFull(nextMatch.kickoffIso) : t("ticket.pending")}</strong>
          </span>
          <span>
            <small>{t("ticket.schedule")}</small>
            <strong>{scheduleVerifiedLabel}</strong>
          </span>
        </div>
        {
          nextMatch && (
            <div class="ticket-market-line" aria-hidden="true">
              <span>{nextMatch.homeTeam}</span>
              <span>{t("ticket.draw")}</span>
              <span>{nextMatch.awayTeam}</span>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  <MatchRail matches={matchBoard} />
</AppLayout>
