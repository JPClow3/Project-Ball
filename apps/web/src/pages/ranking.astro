---
import AppLayout from "@/layouts/AppLayout.astro";
import { formatUsd } from "@/lib/format";
import { getLeaderboard, type LeaderboardEntry } from "@/lib/leaderboard";
import { getRuntimeEnv } from "@/lib/runtime";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro.locals.lang);
const env = getRuntimeEnv();

let leaderboard: LeaderboardEntry[] = [];
let dbAvailable = !!env?.PROJECT_BALL_DB;

try {
  if (dbAvailable) {
    leaderboard = [...await getLeaderboard(env.PROJECT_BALL_DB, 50)];
  }
} catch (error) {
  console.warn("Database is offline. Using empty leaderboard.", error);
  dbAvailable = false;
}

function truncateAddress(address: string): string {
  if (address.length <= 10) return address;
  return `${address.slice(0, 6)}...${address.slice(-4)}`;
}

function getRankBadgeColor(rank: number): string {
  if (rank === 1) return "text-[#FFD700]"; // Gold
  if (rank === 2) return "text-[#C0C0C0]"; // Silver
  if (rank === 3) return "text-[#CD7F32]"; // Bronze
  return "text-[var(--muted)]";
}
---

<AppLayout title={t("nav.ranking")} mainClass="page-stack">
  <section class="surface-panel p-6 md:p-6" transition:name="ranking-hero">
    <p class="eyebrow">
      <i class="fa-solid fa-trophy ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
      {t("ranking.competition")}
    </p>
    <h1 class="font-display mt-4 text-3xl font-extrabold text-[var(--text)] md:text-4xl">{t("ranking.title")}</h1>
    <p class="lede mt-4">
      {t("ranking.desc")}
    </p>
  </section>

  <section class="surface-panel p-4 md:p-6" aria-label={t("ranking.tableLabel")}>
    <div class="flex items-center justify-between gap-4 mb-6">
      <div>
        <p class="text-xs font-black uppercase text-[var(--gold)]">{t("ranking.sectionTitle")}</p>
        <h2 class="font-display mt-2 text-xl font-extrabold text-[var(--text)]">{t("ranking.sectionTitle")}</h2>
      </div>
      <span class:list={["status-pill", dbAvailable ? "status-pill--open" : "status-pill--locked"]}>
        <i class="fa-solid fa-database ui-icon" style="font-size: 16px;" aria-hidden="true"></i>
        {dbAvailable ? t("ranking.database") : t("ranking.demoMode")}
      </span>
    </div>

    {
      dbAvailable && leaderboard.length > 0 ? (
        <div class="overflow-x-auto">
          <table class="w-full text-left" role="table">
            <thead>
              <tr class="border-b border-[var(--line-strong)]">
                <th class="pb-3 pr-4 text-xs font-black uppercase text-[var(--muted)] w-16">{t("ranking.rank")}</th>
                <th class="pb-3 pr-4 text-xs font-black uppercase text-[var(--muted)]">{t("ranking.bettor")}</th>
                <th class="pb-3 pr-4 text-xs font-black uppercase text-[var(--muted)] text-right">{t("ranking.accuracy")}</th>
                <th class="pb-3 pr-4 text-xs font-black uppercase text-[var(--muted)] text-right">{t("ranking.winnings")}</th>
                <th class="pb-3 text-xs font-black uppercase text-[var(--muted)] text-right">{t("ranking.score")}</th>
              </tr>
            </thead>
            <tbody>
              {
                leaderboard.map((entry, index) => (
                  <tr class:list={["border-b border-[var(--line)]", index === 0 && "bg-[color-mix(in_srgb,var(--green)_5%,transparent)]"]}>
                    <td class="py-4 pr-4">
                      <span class:list={["font-display font-bold text-lg", getRankBadgeColor(entry.rank ?? index + 1)]}>
                        {entry.rank ?? index + 1}
                      </span>
                    </td>
                    <td class="py-4 pr-4">
                      <div class="flex items-center gap-3">
                        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-[var(--surface-strong)]">
                          <i class="fa-solid fa-user ui-icon text-[var(--muted)]" style="font-size: 12px;" aria-hidden="true"></i>
                        </div>
                        <div>
                          <p class="font-bold text-sm text-[var(--text)]">
                            {entry.displayName || truncateAddress(entry.walletAddress)}
                          </p>
                          <p class="text-xs font-semibold text-[var(--muted)]">
                            {entry.totalBets} {entry.totalBets === 1 ? t("ranking.bet") : t("ranking.bets")}
                          </p>
                        </div>
                      </div>
                    </td>
                    <td class="py-4 pr-4 text-right">
                      <p class="font-bold text-sm text-[var(--cyan)]">
                        {entry.accuracyPercentage.toFixed(1)}%
                      </p>
                      <p class="text-xs font-semibold text-[var(--muted)]">
                        {entry.correctBets}/{entry.totalBets}
                      </p>
                    </td>
                    <td class="py-4 pr-4 text-right">
                      <p class="font-bold text-sm text-[var(--green)]">
                        {formatUsd(entry.totalWonUsd.toFixed(2))}
                      </p>
                    </td>
                    <td class="py-4 text-right">
                      <p class="font-display font-bold text-sm text-[var(--gold)]">
                        {entry.combinedScore.toFixed(1)}
                      </p>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state-panel">
          <i class="fa-solid fa-trophy ui-icon text-[var(--gold)]" style="font-size: 24px;" aria-hidden="true"></i>
          <div>
            <h3 class="font-display text-lg font-extrabold text-[var(--text)]">
              {dbAvailable ? t("ranking.noData") : t("ranking.noDb")}
            </h3>
            <p class="mt-2 text-sm font-semibold leading-relaxed text-[var(--muted)]">
              {dbAvailable 
                ? t("ranking.noDataDesc")
                : t("ranking.noDbDesc")}
            </p>
          </div>
        </div>
      )
    }
  </section>

  <section class="quiet-card">
    <p class="match-label">{t("ranking.howItWorks")}</p>
    <h2 class="text-xl">{t("ranking.scoringTitle")}</h2>
    <div class="timeline-list mt-4">
      <article class="timeline-item">
        <span class="liquid-icon"><i class="fa-solid fa-bullseye ui-icon text-[var(--cyan)]" style="font-size: 20px;" aria-hidden="true"></i></span>
        <div>
          <h3>{t("ranking.accuracy")} (60%)</h3>
          <p>{t("ranking.accuracyDesc")}</p>
        </div>
      </article>
      <article class="timeline-item">
        <span class="liquid-icon"><i class="fa-solid fa-coins ui-icon text-[var(--green)]" style="font-size: 20px;" aria-hidden="true"></i></span>
        <div>
          <h3>{t("ranking.winnings")} (40%)</h3>
          <p>{t("ranking.winningsDesc")}</p>
        </div>
      </article>
      <article class="timeline-item">
        <span class="liquid-icon"><i class="fa-solid fa-calculator ui-icon text-[var(--gold)]" style="font-size: 20px;" aria-hidden="true"></i></span>
        <div>
          <h3>{t("ranking.score")} (60% + 40%)</h3>
          <p>{t("ranking.combinedDesc")}</p>
        </div>
      </article>
    </div>
  </section>
</AppLayout>
