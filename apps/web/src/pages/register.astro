---
import AppHeader from "@/components/AppHeader.astro";
import PageFooter from "@/components/PageFooter.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { LogIn, ReceiptText, Route, Trophy, UserPlus, Wallet } from "lucide-astro";

const requestedNext = Astro.url.searchParams.get("next");
const nextPath = requestedNext?.startsWith("/") && !requestedNext.startsWith("//") ? requestedNext : "/meus-palpites";
const loginHref = `/login?next=${encodeURIComponent(nextPath)}`;
---

<BaseLayout title="Criar conta | Jonakinho">
  <AppHeader />
  <main class="app-shell app-main" transition:name="page-content">
    <section class="auth-shell">
      <form class="surface-panel auth-panel" data-auth-form>
        <p class="eyebrow">
          <UserPlus size={14} aria-hidden="true" />
          Cadastro
        </p>
        <h1 class="font-display mt-4 text-3xl font-extrabold leading-tight text-[var(--text)] md:text-4xl">Criar conta com MetaMask</h1>
        <p class="lede mt-3">
          Seu perfil fica ligado ao endereço da carteira que assinar a mensagem de cadastro.
        </p>
        <p class="mt-3 inline-flex items-center gap-2 rounded-[999px] border border-[var(--line)] bg-white/[0.045] px-3 py-2 text-xs font-black uppercase text-[var(--muted)]">
          <Route size={14} class="text-[var(--green)]" aria-hidden="true" />
          Depois do cadastro, você segue para {nextPath}
        </p>

        <label class="mt-6 block" for="display-name">
          <span class="text-sm font-black text-[var(--text)]">Nome de exibição</span>
          <input
            id="display-name"
            class="form-control focus-ring mt-2 text-base"
            type="text"
            name="displayName"
            autocomplete="nickname"
            maxlength="48"
            placeholder="Jonakinho"
            data-auth-display-name
          />
        </label>

        <div class="mt-5 rounded-[8px] border border-[var(--line)] bg-white/[0.045] p-4" data-auth-action-panel>
          <p class="text-sm font-bold text-[var(--muted)]" role="status" data-auth-status>
            Pronto para cadastrar.
          </p>
          <button
            class="btn-primary focus-ring mt-4 w-full"
            type="button"
            data-auth-intent="register"
            data-auth-redirect={nextPath}
          >
            <Wallet size={16} aria-hidden="true" />
            Cadastrar com MetaMask
          </button>
          <a
            class="btn-secondary focus-ring mt-3 w-full"
            href={loginHref}
          >
            <LogIn size={16} class="text-[var(--green)]" aria-hidden="true" />
            Já tenho conta
          </a>
        </div>
      </form>

      <aside class="surface-panel editorial-side">
        <div>
          <p class="text-xs font-black uppercase text-[var(--gold)]">Conta</p>
          <h2 class="font-display mt-2 text-2xl font-extrabold text-[var(--text)]">Um perfil por carteira</h2>
        </div>
        <div class="editorial-list">
          <p><Wallet size={16} class="text-[var(--green)]" aria-hidden="true" />Uma carteira conectada ao histórico de palpites.</p>
          <p><ReceiptText size={16} class="text-[var(--cyan)]" aria-hidden="true" />Palpites confirmados aparecem em Meus Palpites.</p>
          <p><Trophy size={16} class="text-[var(--gold)]" aria-hidden="true" />Prêmios usam a mesma sessão de carteira.</p>
        </div>
      </aside>
    </section>
  </main>
  <PageFooter />
</BaseLayout>
