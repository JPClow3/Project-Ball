{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-ball",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./apps/web/dist/server/entry.mjs",
  "assets": {
    "directory": "./apps/web/dist/client",
    "binding": "ASSETS"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "no_bundle": true,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "PROJECT_BALL_DB",
      "database_name": "project-ball-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./apps/web/migrations"
    }
  ],
  // Used by the current Worker SSR deploy (`pnpm --filter @project-ball/web deploy`).
  // PUBLIC_* values are also loaded by the web build script for dashboard builds.
  "vars": {
    "PUBLIC_APP_NAME": "Project Ball",
    "PUBLIC_APP_URL": "https://project-ball.github-broadcast509.workers.dev",
    "PUBLIC_CHAIN_ID": "11142220",
    "PUBLIC_CELO_RPC_URL": "https://forno.celo-sepolia.celo-testnet.org",
    "PUBLIC_CELO_EXPLORER_URL": "https://celo-sepolia.blockscout.com",
    "PUBLIC_PROJECT_BALL_POOLS_ADDRESS": "0x0000000000000000000000000000000000000000",
    "PUBLIC_SUPPORT_URL": "https://t.me/projectball_support"
  }
}
