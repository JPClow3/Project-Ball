{
  "name": "project-ball",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "pnpm --filter @project-ball/shared build && pnpm --filter @project-ball/web build",
    "clean": "node -e \"import('fs').then(fs => ['apps/web/.astro', 'apps/web/node_modules/.vite', 'apps/web/dist', 'packages/shared/dist'].forEach(p => fs.rmSync(p, { recursive: true, force: true })))\"",
    "deploy": "docker compose up -d --build",
    "check": "pnpm -r check",
    "dev": "pnpm --filter @project-ball/web dev",
    "format": "pnpm -r format",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @project-ball/web test:e2e"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@esbuild/win32-x64": "0.28.1",
    "@vitest/coverage-v8": "4.1.8",
    "typescript": "6.0.3"
  }
}
